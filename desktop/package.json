{
  "name": "invoqly-desktop",
  "productName": "Invoqly",
  "version": "1.5.0",
  "private": true,
  "description": "Invoqly invoicing workspace for Windows, macOS and Linux",
  "author": {
    "name": "Invoqly",
    "email": "hello@invoqly.top"
  },
  "homepage": "https://invoqly.top",
  "main": "src/main.cjs",
  "scripts": {
    "start": "electron .",
    "test": "node --test test/policy.test.cjs test/updates.test.cjs test/download.test.cjs test/browser-auth.test.cjs test/platforms.test.cjs",
    "test:desktop": "node test/desktop.test.cjs",
    "build:win": "electron-builder --win nsis --x64 --publish never",
    "build:dir": "electron-builder --win dir --x64 --publish never",
    "audit:package": "node scripts/audit-package.cjs",
    "build:mac": "electron-builder --mac --universal --publish never",
    "build:linux": "electron-builder --linux --publish never"
  },
  "dependencies": {
    "@supabase/supabase-js": "2.118.0",
    "electron-updater": "6.8.9"
  },
  "devDependencies": {
    "@electron/fuses": "2.1.3",
    "@playwright/test": "1.64.1",
    "electron": "45.0.0",
    "electron-builder": "26.15.3"
  },
  "build": {
    "appId": "top.invoqly.desktop",
    "productName": "Invoqly",
    "asar": true,
    "directories": {
      "output": "dist",
      "buildResources": "assets"
    },
    "files": [
      "src/**/*",
      "assets/invoqly.ico",
      "assets/invoqly.png",
      "package.json",
      "!**/*.map"
    ],
    "protocols": [
      {
        "name": "Invoqly sign-in",
        "schemes": [
          "invoqly"
        ]
      }
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "assets/invoqly.ico",
      "artifactName": "Invoqly-Setup.exe",
      "requestedExecutionLevel": "asInvoker"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Invoqly",
      "deleteAppDataOnUninstall": true,
      "runAfterFinish": true
    },
    "afterPack": "scripts/harden.cjs",
    "publish": [
      {
        "provider": "generic",
        "url": "https://invoqly.top/downloads/windows/"
      }
    ],
    "compression": "normal",
    "mac": {
      "target": [
        {
          "target": "dmg",
          "arch": [
            "universal"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "universal"
          ]
        }
      ],
      "icon": "assets/invoqly-mac.png",
      "category": "public.app-category.finance",
      "artifactName": "Invoqly-${version}-${arch}.${ext}",
      "hardenedRuntime": true,
      "entitlements": "assets/entitlements.mac.plist",
      "entitlementsInherit": "assets/entitlements.mac.plist",
      "notarize": false,
      "publish": [
        {
          "provider": "generic",
          "url": "https://invoqly.top/downloads/macos/"
        }
      ]
    },
    "linux": {
      "target": [
        {
          "target": "AppImage",
          "arch": [
            "x64",
            "arm64"
          ]
        },
        {
          "target": "deb",
          "arch": [
            "x64",
            "arm64"
          ]
        }
      ],
      "executableName": "invoqly",
      "icon": "assets/invoqly.png",
      "category": "Office",
      "artifactName": "Invoqly-${version}-${arch}.${ext}",
      "desktop": {
        "entry": {
          "Name": "Invoqly",
          "Comment": "Create, send and track invoices",
          "Categories": "Office;Finance;",
          "MimeType": "x-scheme-handler/invoqly;"
        }
      },
      "publish": [
        {
          "provider": "generic",
          "url": "https://invoqly.top/downloads/linux/"
        }
      ],
      "syncDesktopName": true,
      "maintainer": "Invoqly <hello@invoqly.top>"
    }
  },
  "desktopName": "invoqly.desktop"
}
